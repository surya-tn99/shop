<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product</title>
    <% for(let cssPath of cssPaths) { %>
    <link rel="stylesheet" href=<%= cssPath %> >    
    <% } %>

</head>
<body>
    <nav>
        <ul>
            <li><a href="/">Shop</a></li>
            <li id="active"><a href="/product">Product</a></li>
            <li><a href="cart">Cart</a></li>
            <li><a href="/product/add">Add product</a></li>
            <li><a href="/product/admin">Admin product</a></li>
        </ul>
    </nav>
    <main>
        <% for(let product of products) { %>
        <div class="product">
            <fieldset>
                <legend><%= product.title %></legend>

                <div class="price">₹<%= product.price %></div>
                
                <div class="description">
                    <%= product.description %>
                </div>

                <button class="btn">Add To Cart</button>
            </fieldset>
        </div>
        <% } %>
    </main>
</body>
</html>