<main>
    <div class="product">
        <h4>Product Detail</h4>
        <fieldset>
            <legend><%= products.title %></legend>

            <div class="price">₹<%= products.price %></div>
            
            <div class="description">
                <%= products.description %>
            </div>

            <button class="btn">Add To Cart</button>

        </fieldset>
    </div>
</main>