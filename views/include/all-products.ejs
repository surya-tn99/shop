<main>

    <% if(products.length > 0) { %>        
        <% for(let product of products) { %>
        <div class="product">
            <fieldset>
            
                <legend><%= product.title %></legend>

                <div class="price">₹<%= product.price %></div>
                
                <div class="description">
                    <%= product.description %>
                </div>

                <% if(active === "admin") {%>
                    
                    <button class="btn"><a href="/admin/edit-product?productID=<%=product.id%>">Edit</a></button>
                    <form action="/admin/modify?delete=true&productID=<%=product.id%>" method="post">
                            
                            <button type="submit" class="btn">Delete</button>    
                    </form>    

                <% } else {%>
                    <button class="btn"><a href="/product/<%= product.id %>">Details</a></button>
                    
                    <% if(active === "cart") {%>
                        <button class="cart-qty-btn">Quantity : <%= product.quantity %>
                        </button>
                        <button class="btn"><a href="/cart/qty?productID=<%= product.id %>&value=1">  Increase  </a></button>
                        <button class="btn"><a href="/cart/qty?productID=<%= product.id %>&value=-1">  Descrease  </a></button>

                    <% } else {%>
                        <form action="/cart" method="post">
                            <input type="hidden" name="id" value="<%= product.id %>"/>
                            <input type="hidden" name="price" value="<%= product.price %>"/>
                            
                            <button type="submit" class="btn">Add To Cart</button>
                        
                        </form>
                        
                    <% }%>
                <% }%>

            </fieldset>
        </div>
        <% } %>

        <% if(active == "cart"){ %>
            <h3 class="title">Total Price : <%= totalPrice %></h3>  
        <% } %>
    
    <% } else { %>
        <h3 class="title">No Product At Cart</h3>
    <% } %>
</main>
